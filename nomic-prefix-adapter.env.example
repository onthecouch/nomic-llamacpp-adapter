# Address exposed to trusted embedding clients. Keep 127.0.0.1 for local-only use.
ADAPTER_BIND_HOST=127.0.0.1
ADAPTER_BIND_PORT=8081

# Loopback-only llama-server endpoint.
ADAPTER_UPSTREAM=http://127.0.0.1:8082

# Optional explicit health URL used by migrate-services.sh.
# ADAPTER_HEALTH_URL=http://127.0.0.1:8081/health
